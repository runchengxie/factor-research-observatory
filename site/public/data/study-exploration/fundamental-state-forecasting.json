  "steps": [
    {
      "id": "first",
      "period": {
        "en-US": "2026-09-02",
        "zh-CN": "2026-09-02"
      },
      "status": "diagnostic",
      "title": {
        "en-US": "Find persistence and an early growth signal",
        "zh-CN": "识别持续性与早期增长亮点"
      },
      "question": {
        "en-US": "Which targets are forecastable?",
        "zh-CN": "哪些财务目标较可预测？"
      },
      "finding": {
        "en-US": "ROA and gross margin were persistent. Net-profit-growth Rank IC was 0.134 for XGBoost versus -0.065 for persistence in one panel.",
        "zh-CN": "ROA、毛利率有持续性；一个面板中净利润增速 Rank IC 为 XGBoost 0.134、persistence -0.065。"
      },
      "decision": {
        "en-US": "Retain the positive observation, but do not compare it directly with a different panel or treat it as stock-return alpha.",
        "zh-CN": "保留正向观察，但不与不同面板直接比较，也不视为股票收益 Alpha。"
      },
      "source_ids": [
        "first"
      ]
    },
    {
      "id": "correct",
      "period": {
        "en-US": "2026-09-04",
        "zh-CN": "2026-09-04"
      },
      "status": "diagnostic",
      "title": {
        "en-US": "Correct the baseline and compare common folds",
        "zh-CN": "修正基线并比较共同折"
      },
      "question": {
        "en-US": "Do ranking objectives outperform current-state persistence?",
        "zh-CN": "排序目标是否超过当期状态持续性基线？"
      },
      "finding": {
        "en-US": "An invalid initial run let persistence read future labels. The corrected 30-cell comparison removes it and persistence leads ROA and gross margin at all horizons.",
        "zh-CN": "最初无效运行让 persistence 读取未来标签；修正后的 30 单元对照剔除该结果，ROA、毛利率各期限均由 persistence 领先。"
      },
      "decision": {
        "en-US": "Use only the corrected results; keep numeric, pairwise and listwise objectives under the same folds.",
        "zh-CN": "仅使用修正结果，数值、成对与列表目标保持同折。"
      },
      "source_ids": [
        "objectives"
      ]
    },
    {
      "id": "bridge",
      "period": {
        "en-US": "2026-09-04",
        "zh-CN": "2026-09-04"
      },
      "status": "diagnostic",
      "title": {
        "en-US": "Separate forecast accuracy from stock selection",
        "zh-CN": "分开预测准确度与选股"
      },
      "question": {
        "en-US": "Does target predictability improve portfolios?",
        "zh-CN": "目标可预测性是否改善组合？"
      },
      "finding": {
        "en-US": "Common-date portfolio bridges and longer-horizon growth/cash-conversion diagnostics remain unstable.",
        "zh-CN": "共同日期组合桥接及长期增长、现金转化诊断仍不稳定。"
      },
      "decision": {
        "en-US": "Continue simple operating-state research; no model or portfolio promotion.",
        "zh-CN": "继续简单经营状态研究，不提升模型或组合资格。"
      },
      "source_ids": [
        "overview"
      ]
    }
  ],
